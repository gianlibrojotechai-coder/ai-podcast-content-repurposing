# Podcast to Content Pipeline - environment
# cp .env.example .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=n8n

# --- n8n identity ---
# N8N_HOST is the public hostname (no scheme, no trailing slash).
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/

# Affects $now and all cron scheduling. Set to the podcast's publishing timezone.
GENERIC_TIMEZONE=Asia/Manila

# --- Encryption ---
# Generate with:  openssl rand -hex 32
#
# CRITICAL: this key encrypts every stored credential. If it changes or is lost,
# every credential in the instance becomes permanently unreadable and must be
# re-entered by hand. Back it up separately from this file and from the server.
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32


# ---------------------------------------------------------------------------
# API keys are deliberately NOT listed here.
#
# AssemblyAI, OpenAI, Notion, and Slack credentials live in n8n's encrypted
# credential store and are referenced by ID from the workflow. Putting them in
# environment variables would place plaintext secrets in this file, in your
# shell history, and in `docker inspect` output.
#
# Create them in the n8n UI under Credentials:
#
#   AssemblyAI  -> type: Header Auth
#                  Name:  Authorization
#                  Value: <your API key>          (NO "Bearer " prefix)
#
#   Notion      -> type: Notion API
#                  Internal integration token from notion.so/my-integrations
#                  Then share the target database with the integration:
#                  database -> ... -> Connections -> add integration
#
#   OpenAI      -> already configured on this instance
#   Slack       -> already configured; attach it to the three Slack nodes
# ---------------------------------------------------------------------------
