              "value": "={{ ($json.chapters ?? []).map(c => Math.floor(c.start/60000).toString().padStart(2,\"0\") + \":\" + Math.floor((c.start%60000)/1000).toString().padStart(2,\"0\") + \" - \" + c.headline + \" - \" + c.gist).join(\"\\n\") }}",
              "type": "string"
