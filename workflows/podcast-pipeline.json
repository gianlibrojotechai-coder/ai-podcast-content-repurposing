              "value": "={{ ($(\"Generate Social Content\").item.json.output.facebook_post ?? \"\").slice(0, 1900) }}",
              "type": "string"
            },
            {
              "id": "a-ig",
              "name": "instagramCaption",
              "value": "={{ ($(\"Generate Social Content\").item.json.output.instagram_caption ?? \"\").slice(0, 1900) }}",
              "type": "string"
            },
            {
              "id": "a-qt",
              "name": "pullQuotes",
              "value": "={{ ($(\"Generate Social Content\").item.json.output.pull_quotes ?? []).map((q, i) => (i+1) + \". \" + q).join(\"\\n\") }}",
              "type": "string"
            },
            {
              "id": "a-btitle",
              "name": "blogTitle",
              "value": "={{ ($(\"Generate SEO and Blog\").item.json.output.blog_title ?? \"\").slice(0, 1900) }}",
              "type": "string"
            },
